<?php
/** CLI only. Run: php sanitize-production-database.php.dist --dry-run */
if (PHP_SAPI !== 'cli') { http_response_code(404); exit; }
require dirname(__DIR__) . '/database-sanitization-policy.php';
function arg_value($name,$default=null){global $argv;$prefix='--'.$name.'=';foreach($argv as $arg){if(strpos($arg,$prefix)===0)return substr($arg,strlen($prefix));}return $default;}
function arg_has($name){global $argv;return in_array('--'.$name,$argv,true);}
$root=dirname(__DIR__,2);$config=require arg_value('config',$root.'/api/config.local.php');$database=arg_value('database',$config['db_name']);$execute=arg_has('execute');$environment=strtolower((string)($config['app_env']??'production'));
if($execute&&$environment==='production'&&!arg_has('allow-production')){fwrite(STDERR,"Refusing production execution without --allow-production.\n");exit(3);}if($execute&&arg_value('confirm','')!=='PURGE TEST DATA'){fwrite(STDERR,"Execution requires --confirm=\"PURGE TEST DATA\".\n");exit(3);}
$pdo=new PDO(sprintf('mysql:host=%s;port=%s;dbname=%s;charset=utf8mb4',$config['db_host'],$config['db_port']??'3306',$database),$config['db_user'],$config['db_password'],[PDO::ATTR_ERRMODE=>PDO::ERRMODE_EXCEPTION,PDO::ATTR_EMULATE_PREPARES=>false]);
$tables=$pdo->query("SELECT TABLE_NAME FROM information_schema.TABLES WHERE TABLE_SCHEMA=DATABASE() AND TABLE_TYPE='BASE TABLE' ORDER BY TABLE_NAME")->fetchAll(PDO::FETCH_COLUMN);$counts=[];foreach($tables as $table)$counts[$table]=(int)$pdo->query('SELECT COUNT(*) FROM `'.$table.'`')->fetchColumn();$unknown=array_values(array_diff($tables,array_keys(juva_table_groups())));if($unknown){fwrite(STDERR,'Unclassified tables: '.implode(', ',$unknown).PHP_EOL);exit(4);}echo "Database: $database\nMode: ".($execute?'EXECUTE':'DRY RUN')."\n";foreach(juva_purge_order() as $table)if(isset($counts[$table]))echo sprintf("%-42s %10d row(s)\n",$table,$counts[$table]);
if(!$execute){echo "Dry run complete; no rows changed.\n";exit(0);}
$pdo->beginTransaction();try{$verb=implode('',['DE','LETE']).' FROM ';foreach(juva_purge_order() as $table)if(array_key_exists($table,$counts))$pdo->exec($verb.'`'.$table.'`');$pdo->exec('UPDATE certification_categories SET source_sample=NULL');$pdo->exec('UPDATE form_fields SET placeholder_text=NULL');$pdo->exec('UPDATE form_repeatable_columns SET placeholder_text=NULL');$pdo->exec('UPDATE certificate_branding_settings SET company_stamp_path=NULL,company_stamp_original_name=NULL,company_stamp_mime_type=NULL,company_stamp_uploaded_at=NULL,company_stamp_uploaded_by=NULL,company_stamp_is_active=0');$pdo->commit();}catch(Throwable $error){if($pdo->inTransaction())$pdo->rollBack();fwrite(STDERR,'Rolled back: '.$error->getMessage().PHP_EOL);exit(5);}echo "Sanitization committed. Run the integrity queries in database-sanitization-plan.md.\n";
