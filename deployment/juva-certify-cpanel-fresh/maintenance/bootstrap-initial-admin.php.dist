<?php
if (PHP_SAPI !== 'cli') { http_response_code(404); exit; }
$root=dirname(__DIR__,2);$configPath=getenv('JUVA_CONFIG_PATH')?:$root.'/api/config.local.php';if(!is_file($configPath)){fwrite(STDERR,"Set JUVA_CONFIG_PATH.\n");exit(2);}
$name=trim((string)getenv('INITIAL_ADMIN_NAME'));$email=strtolower(trim((string)getenv('INITIAL_ADMIN_EMAIL')));$username=trim((string)getenv('INITIAL_ADMIN_USERNAME'));$password=(string)getenv('INITIAL_ADMIN_PASSWORD');if($name===''||$username===''||!filter_var($email,FILTER_VALIDATE_EMAIL)||strlen($password)<12){fwrite(STDERR,"Set valid INITIAL_ADMIN_NAME, INITIAL_ADMIN_EMAIL, INITIAL_ADMIN_USERNAME and a 12+ character INITIAL_ADMIN_PASSWORD.\n");exit(3);}
$config=require $configPath;$databaseOverride=trim((string)getenv('INITIAL_ADMIN_DATABASE'));if($databaseOverride!=='')$config['db_name']=$databaseOverride;$pdo=new PDO(sprintf('mysql:host=%s;port=%s;dbname=%s;charset=utf8mb4',$config['db_host'],$config['db_port']??'3306',$config['db_name']),$config['db_user'],$config['db_password'],[PDO::ATTR_ERRMODE=>PDO::ERRMODE_EXCEPTION,PDO::ATTR_EMULATE_PREPARES=>false]);if((int)$pdo->query('SELECT COUNT(*) FROM users')->fetchColumn()!==0){fwrite(STDERR,"Bootstrap refused: a user exists.\n");exit(4);}$role=$pdo->query("SELECT id FROM roles WHERE slug='super-admin' LIMIT 1")->fetchColumn();if(!$role){fwrite(STDERR,"Super Admin role missing.\n");exit(5);}
$now=gmdate('Y-m-d H:i:s');$pdo->beginTransaction();try{$insert=$pdo->prepare('INSERT INTO users (role_id,name,email,username,password_hash,status,email_verified_at,sessions_revoked_at,created_at,updated_at) VALUES (?,?,?,?,?,?,?,?,?,?)');$insert->execute([(int)$role,$name,$email,$username,password_hash($password,PASSWORD_DEFAULT),'active',$now,$now,$now,$now]);$id=(int)$pdo->lastInsertId();$audit=$pdo->prepare('INSERT INTO audit_logs (user_id,action,entity_type,entity_id,metadata_json,created_at) VALUES (?,?,?,?,?,?)');$audit->execute([$id,'production.initial_super_admin_created','user',$id,json_encode(['source'=>'cli_environment_bootstrap']),$now]);$pdo->commit();}catch(Throwable $error){if($pdo->inTransaction())$pdo->rollBack();fwrite(STDERR,'Bootstrap failed: '.$error->getMessage().PHP_EOL);exit(6);}echo "Initial Super Admin created. Clear INITIAL_ADMIN_* variables and remove this utility.\n";
